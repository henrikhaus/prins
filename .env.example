# Copy to .env. `prins run` loads it from the current directory.
# Everything is optional except that without ANTHROPIC_API_KEY notes are only lightly cleaned up.

ANTHROPIC_API_KEY=
PRINS_MODEL=claude-haiku-5-5

# Where confirmed notes go: preview (PNG files), atech (printer on the board's UART port),
# or serial (a printer that shows up as a serial port on the Mac).
PRINS_PRINTER=preview
PRINS_PRINTER_PORT=
PRINS_PRINTER_BAUD=9600
PRINS_PRINTER_BYTES_PER_SEC=900
# 384 dots suits most 58 mm printers. Check your printer's self-test page.
PRINS_PRINTER_DOTS=384

# Leave empty to use the first Atech board found on USB.
PRINS_BOARD_PORT=

# Slack, Socket Mode. See docs/CONNECTORS.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your member ID. Only your :printer: reactions create notes.
PRINS_SLACK_OWNER=

# Email, read-only IMAP. See docs/CONNECTORS.md.
PRINS_IMAP_HOST=
PRINS_IMAP_USER=
PRINS_IMAP_PASSWORD=
PRINS_IMAP_FOLDER=INBOX
