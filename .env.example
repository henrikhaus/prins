# Copy to .env. `prins run` loads it from the current directory.
# Everything is optional except that without ANTHROPIC_API_KEY notes are only lightly cleaned up.

ANTHROPIC_API_KEY=
PRINS_MODEL=claude-haiku-5-5

# Where confirmed notes go: m110 (the real label printer, run printer/server.py too),
# preview (PNG files), atech (printer on the board's UART port), or serial (a printer that
# shows up as a serial port on the Mac).
PRINS_PRINTER=m110
PRINS_M110_URL=http://127.0.0.1:8110
PRINS_PRINTER_PORT=
PRINS_PRINTER_BAUD=9600
PRINS_PRINTER_BYTES_PER_SEC=900
# Notes are 312x216 and print centered on the paper. 384 dots suits most 58 mm printers.
PRINS_PRINTER_DOTS=384

# Leave empty to use the first Atech board found on USB.
PRINS_BOARD_PORT=

# Label maker (`prins labels`). The drawing agent needs ANTHROPIC_API_KEY above.
PRINS_LABEL_MODEL=claude-sonnet-5-5
# Whisper model for speech to text, run on this Mac. tiny, base, small, medium or turbo.
# turbo is the most accurate and downloads about 1.6 GB the first time.
PRINS_STT_MODEL=turbo
# Leave empty to detect the language, or set a code such as en or no.
PRINS_STT_LANGUAGE=
PRINS_LABEL_PRINTER_URL=http://127.0.0.1:8110

# Slack, Socket Mode. See docs/CONNECTORS.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your member ID. Only your :printer: reactions create notes.
PRINS_SLACK_OWNER=

# Email, read-only IMAP. See docs/CONNECTORS.md.
PRINS_IMAP_HOST=
PRINS_IMAP_USER=
PRINS_IMAP_PASSWORD=
PRINS_IMAP_FOLDER=INBOX

# Dashboard sync, off unless both are set. Get them from the dashboard's Devices page.
# Sends the short note, source, sender and device status. Never the raw message or audio.
PRINS_CLOUD_URL=
PRINS_CLOUD_TOKEN=

# When your own agent prints through MCP, skip the green button. Friends always need the button.
PRINS_AGENT_AUTO_PRINT=false

# Your name, for the FROM line on a poster you send to a friend.
# PRINS_NAME=
